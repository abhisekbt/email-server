# ==============================================================================
# Backend Server Production Environment Variables
# ==============================================================================

# Server configuration
NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://portal.yourdomain.com

# Primary PostgreSQL Database
DATABASE_URL=postgres://postgres:your_secure_password@localhost:5432/reconepal

# Supabase Fallback / Standby Database (Disaster Recovery)
# Example Supabase pooled URL: postgres://postgres.projectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=
SUPABASE_SYNC_INTERVAL_MINUTES=60

# Default SMTP Relay Fallback (Can be updated live in Settings)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@reconepal.com
SMTP_PASSWORD=your-app-password
SMTP_ENCRYPTION=tls
SMTP_SENDER_EMAIL=advisory@reconepal.com
SMTP_SENDER_NAME=RecoNepal Advisory Desk
