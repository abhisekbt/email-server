# Server
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Primary PostgreSQL Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reconepal

# (Optional) Supabase Fallback & Disaster Recovery Database
# Set this to enable automatic failover if primary DB goes down, plus periodic standby sync
# Example Supabase pooled string: postgres://postgres.yourref:yourpass@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
SUPABASE_DATABASE_URL=
SUPABASE_SYNC_INTERVAL_MINUTES=60

# SMTP default fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=changeme
SMTP_ENCRYPTION=tls
SMTP_SENDER_EMAIL=noreply@example.com
SMTP_SENDER_NAME=RecoNepal
